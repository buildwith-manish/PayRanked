{
  "name": "payranked",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render:half": "remotion render src/index.ts Video2 out/video2-half.mp4 --scale=0.5",
    "render": "remotion render src/index.ts Video2 out/video2.mp4 --codec=h264 --crf=16 --x264-preset=slow --tune=film --audio-codec=aac --audio-bitrate=320k",
    "sfx": "python3 scripts/make_sfx.py",
    "previews": "node scripts/dump-cues.mjs && python3 scripts/make_audio_previews.py",
    "vo-envelope": "python3 scripts/vo_envelope.py",
    "timing": "node scripts/export-timing.mjs",
    "music": "python3 scripts/make_music2.py",
    "vo-cues": "node scripts/export-timing.mjs && python3 scripts/vo_cues.py"
  },
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "@remotion/cli": "4.0.250",
    "@remotion/google-fonts": "4.0.250",
    "@remotion/motion-blur": "4.0.250",
    "@remotion/noise": "4.0.250",
    "@remotion/shapes": "4.0.250",
    "@remotion/three": "4.0.250",
    "@remotion/transitions": "4.0.250",
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.250",
    "three": "^0.166.1",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/three": "^0.166.0",
    "typescript": "^5.5.4"
  }
}
